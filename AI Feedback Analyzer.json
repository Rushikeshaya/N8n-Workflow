        "options": {
          "temperature": 0.2
        }
      },
      "id": "b950e638-7107-4963-b693-bbffb2efb4c6",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -1040,
        320
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "3YCrwNoWKjKrU0YG",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"themes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sentiment\": {\"type\": \"string\"}, \"urgency\": {\"type\": \"string\"}, \"confidence\": {\"type\": \"number\"}, \"summary\": {\"type\": \"string\"}}}"
      },
      "id": "2fa76095-8778-494b-b5bb-0c0a7c4bdef6",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -848,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const ALLOWED = [\"Teaching Quality\",\"Course Content\",\"Assessment & Exams\",\"Infrastructure & Labs\",\"Faculty Support\",\"Workload\",\"Administration\",\"Other\"];\nconst out = [];\nfor (const item of $input.all()) {\n  const ai = item.json.output || item.json;\n  let themes = (ai.themes || []).filter(t => ALLOWED.includes(t));\n  if (themes.length === 0) themes = [\"Other\"];\n  const sentiment = String(ai.sentiment || \"neutral\").toLowerCase();\n  const urgency = String(ai.urgency || \"low\").toLowerCase();\n  const confidence = Number(ai.confidence ?? 0);\n  const needs_review = sentiment === \"negative\" || urgency === \"high\" || confidence < 0.6;\n  const base = $('Edit Fields').item.json;\n  out.push({ json: { ...base, themes: themes.join(\", \"), sentiment, urgency, confidence, summary: ai.summary || \"\", needs_review } });\n}\nreturn out;"
      },
