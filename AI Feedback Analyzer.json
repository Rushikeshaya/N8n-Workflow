    {
      "parameters": {
        "promptType": "define",
        "text": "=Course: {{ $json.course }}\nFaculty: {{ $json.faculty }}\nRating: {{ $json.rating }}\nFeedback: {{ $json.feedback }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a Student Feedback Analyzer for a college. Read ONE piece of student feedback and classify it. Never invent details not in the text.\n\nALLOWED THEMES (choose 1 to 3): Teaching Quality, Course Content, Assessment & Exams, Infrastructure & Labs, Faculty Support, Workload, Administration, Other\n\nRULES:\n1. sentiment: positive, neutral or negative.\n2. urgency = \"high\" ONLY if text mentions safety, harassment, discrimination, serious misconduct, or a facility completely unusable. \"medium\" for repeated/strong complaints, else \"low\".\n3. confidence: number 0-1. Use below 0.6 if vague, very short or mixed.\n4. summary: one neutral sentence, max 25 words, in English.\n5. Hindi/Marathi/Hinglish input is allowed; answer in English.\n6. Return ONLY valid JSON, no markdown."
            }
          ]
        }
      },
      "id": "d71da196-e4e5-4315-b079-1c2a716aa225",
      "name": "Feedback Analyzer (LLM Chain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -1024,
        112
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
